{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://raviranjan-os-backend.onrender.com/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/console.html"
    },
    {
      "source": "/admin/",
      "destination": "/console.html"
    },
    {
      "source": "/console",
      "destination": "/console.html"
    },
    {
      "source": "/cms",
      "destination": "/admin_cms.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
