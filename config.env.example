# ==============================================================================
# Raviranjan.OS — Environment Configuration Template (.env.example / config.env.example)
# Duplicate this file as '.env' or 'config.env' and paste your real credentials.
# Note: '.env' and 'config.env' are listed in .gitignore and will NEVER be pushed to GitHub.
# ==============================================================================

# 1. DATABASE CONFIGURATION (Neon Cloud PostgreSQL / Supabase / Local Docker)
# Neon DB Pooler JDBC URL example:
# jdbc:postgresql://ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?user=neondb_owner&password=YOUR_PASSWORD&sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Alternative environment variable name for Neon connection string:
NEON_DB_URL=

# Local Docker Database Credentials (used as automatic fallback if Neon DB URL is blank)
POSTGRES_DB=raviranjan_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# 2. GENERATIVE AI ASSISTANT (Google Gemini 1.5 Flash)
# Get free from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. REDIS (Caching, SSE Realtime Events & Pub/Sub)
# For Upstash Cloud Redis, set SPRING_DATA_REDIS_SSL_ENABLED=true
# For local Docker Redis, set host to 'redis' and SSL to 'false'
SPRING_REDIS_HOST=
SPRING_REDIS_PORT=6379
SPRING_REDIS_USERNAME=default
SPRING_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false

# 4. JWT SECURITY & AUTHENTICATION
# 256-bit Base64-encoded JWT signing secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# 5. EXTERNAL DEVELOPER TELEMETRY & INTEGRATIONS (Optional)
GITHUB_API_TOKEN=
GITHUB_USERNAME=raviranjankrmaurya
LEETCODE_USERNAME=raviranjanmaurya
GFG_USERNAME=raviranjankrmaurya
